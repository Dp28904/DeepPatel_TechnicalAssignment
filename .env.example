# Copy this file to .env and adjust values. Never commit .env.

# Application
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=28800
LOG_LEVEL=INFO

# Database (matches docker-compose.yml defaults)
DATABASE_URL=mysql+pymysql://sales_app:sales_app_pw@127.0.0.1:3306/sales_db
TEST_DATABASE_URL=mysql+pymysql://sales_app:sales_app_pw@127.0.0.1:3306/sales_test
# Only for a hosted MySQL that requires TLS (e.g. Aiven): its CA certificate, either as a
# file path OR as the certificate text itself.
# DATABASE_SSL_CA=/etc/secrets/ca.pem
# DATABASE_SSL_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# MySQL container settings (read by docker-compose.yml)
MYSQL_ROOT_PASSWORD=root_pw_change_me
MYSQL_DATABASE=sales_db
MYSQL_USER=sales_app
MYSQL_PASSWORD=sales_app_pw
MYSQL_PORT=3306

# Docker app container (docker compose up --build)
APP_PORT=8000
# Load sample data when the container starts (safe to repeat)
SEED_ON_START=true

# Sample accounts created by `python -m db.seed`.
# These are placeholder sample values, not real credentials. Change them in your .env.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin@123
SEED_SALES1_EMAIL=sales1@example.com
SEED_SALES1_PASSWORD=sales1@123
SEED_SALES2_EMAIL=sales2@example.com
SEED_SALES2_PASSWORD=sales2@123
